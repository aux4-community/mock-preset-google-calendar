{
  "scope": "community",
  "name": "mock-preset-google-calendar",
  "version": "0.0.2",
  "description": "Google Calendar preset for aux4/mock (calendar list, events CRUD, quickAdd, freeBusy)",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "mock",
    "preset",
    "google",
    "calendar",
    "test"
  ],
  "dependencies": [
    "aux4/mock",
    "community/mock-preset-google-auth"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "mock",
          "execute": [
            "profile:mock"
          ],
          "help": {
            "text": "Programmable HTTP mock server for tests"
          }
        }
      ]
    },
    {
      "name": "mock",
      "commands": [
        {
          "name": "preset",
          "execute": [
            "profile:mock:preset"
          ],
          "help": {
            "text": "Apply a service preset to a running mock. Presets are installable packages (community/mock-preset-<service>) that add commands here."
          }
        }
      ]
    },
    {
      "name": "mock:preset",
      "commands": [
        {
          "name": "google",
          "execute": [
            "profile:mock:preset:google"
          ],
          "help": {
            "text": "Google presets. `auth` stands up the credentials every Google API needs; the per-service presets (community/mock-preset-google-<service>) add their endpoints here."
          }
        }
      ]
    },
    {
      "name": "mock:preset:google",
      "commands": [
        {
          "name": "calendar",
          "execute": [
            "aux4 mock stub param(port) param(name) param(stateDir) --method GET --path /users/me/calendarList --status 200 --body value(calendarListBody)",
            "aux4 mock stub param(port) param(name) param(stateDir) --method GET --path '/calendars/{calendarId}/events' --status 200 --body value(eventsBody)",
            "file:${thenFile}:${createThenBody}",
            "aux4 mock stub param(port) param(name) param(stateDir) --method POST --path '/calendars/{calendarId}/events' --status 200 --body value(eventBody) --thenFile ${thenFile}",
            "aux4 mock stub param(port) param(name) param(stateDir) --method POST --path '/calendars/{calendarId}/events/quickAdd' --status 200 --body value(eventBody)",
            "aux4 mock stub param(port) param(name) param(stateDir) --method GET --path '/calendars/{calendarId}/events/{eventId}' --status 200 --body value(eventBody)",
            "file:${thenFile}:${patchThenBody}",
            "file:${patchBodyFile}:${patchResponseBody}",
            "aux4 mock stub param(port) param(name) param(stateDir) --method PATCH --path '/calendars/{calendarId}/events/{eventId}' --status 200 --bodyFile ${patchBodyFile} --thenFile ${thenFile}",
            "file:${thenFile}:${deleteThenBody}",
            "aux4 mock stub param(port) param(name) param(stateDir) --method DELETE --path '/calendars/{calendarId}/events/{eventId}' --status 204 --body '{}' --thenFile ${thenFile}",
            "aux4 mock stub param(port) param(name) param(stateDir) --method POST --path /freeBusy --status 200 --body value(freeBusyBody)",
            "rm -f ${thenFile}"
          ],
          "help": {
            "text": "Register the Google Calendar API on a running mock: calendarList, the events collection and item (GET/POST/PATCH/DELETE), quickAdd, and freeBusy. A create/update/delete also reprograms the GET endpoints so a later read reflects it (create -> appears in GET by id; update -> GET reflects the new start/end/summary; delete -> GET 404s and drops out of the list). Run `mock preset google auth` first for credentials",
            "variables": [
              {
                "name": "port",
                "text": "Port of the running mock server (derives stateDir)",
                "default": "7070"
              },
              {
                "name": "name",
                "text": "Stable handle of the server (derives stateDir; takes precedence over --port)",
                "default": ""
              },
              {
                "name": "stateDir",
                "text": "Explicit state directory (highest precedence)",
                "default": ""
              },
              {
                "name": "thenFile",
                "text": "Internal scratch file this command writes and reuses to pass --thenFile JSON to aux4/mock (the JSON references ${path.*}/${body.*}, whose names collide with this command's own --path/--body flags, so it must travel through a file rather than inline --then). Removed when the command finishes",
                "default": ".mock-preset-google-calendar-then-${port}${name}.json"
              },
              {
                "name": "calendar",
                "text": "Summary (display name) of the calendar returned by calendarList",
                "default": "Sally"
              },
              {
                "name": "calendarId",
                "text": "Calendar id returned by calendarList. Paths match any calendar id regardless of this value",
                "default": "primary"
              },
              {
                "name": "eventId",
                "text": "Id of the event returned by the event endpoints",
                "default": "evt1"
              },
              {
                "name": "event",
                "text": "Summary (title) of the event returned by the event endpoints",
                "default": "Team sync"
              },
              {
                "name": "start",
                "text": "Start time of the returned event, RFC3339",
                "default": "2026-01-15T09:00:00Z"
              },
              {
                "name": "end",
                "text": "End time of the returned event, RFC3339",
                "default": "2026-01-15T10:00:00Z"
              },
              {
                "name": "calendarListBody",
                "text": "calendarList response body (derived from --calendar/--calendarId)",
                "default": "{\"kind\":\"calendar#calendarList\",\"items\":[{\"kind\":\"calendar#calendarListEntry\",\"id\":\"${calendarId}\",\"summary\":\"${calendar}\",\"primary\":true,\"accessRole\":\"owner\"}]}"
              },
              {
                "name": "eventBody",
                "text": "Single event body, returned by get/create/update/quickAdd (derived from --eventId/--event/--start/--end)",
                "default": "{\"kind\":\"calendar#event\",\"id\":\"${eventId}\",\"status\":\"confirmed\",\"summary\":\"${event}\",\"start\":{\"dateTime\":\"${start}\"},\"end\":{\"dateTime\":\"${end}\"}}"
              },
              {
                "name": "eventsBody",
                "text": "Events list body (derived from the event flags)",
                "default": "{\"kind\":\"calendar#events\",\"summary\":\"${calendar}\",\"items\":[{\"kind\":\"calendar#event\",\"id\":\"${eventId}\",\"status\":\"confirmed\",\"summary\":\"${event}\",\"start\":{\"dateTime\":\"${start}\"},\"end\":{\"dateTime\":\"${end}\"}}]}"
              },
              {
                "name": "freeBusyBody",
                "text": "freeBusy response body (derived from --calendarId/--start/--end)",
                "default": "{\"kind\":\"calendar#freeBusy\",\"calendars\":{\"${calendarId}\":{\"busy\":[{\"start\":\"${start}\",\"end\":\"${end}\"}]}}}"
              },
              {
                "name": "deleteThenBody",
                "text": "aux4/mock --then for a delete: makes a later GET of that event 404 and drops it from the events list",
                "default": "[{\"method\":\"GET\",\"path\":\"/calendars/${path.calendarId}/events/${path.eventId}\",\"status\":404,\"body\":\"{\\\"error\\\":{\\\"errors\\\":[{\\\"domain\\\":\\\"global\\\",\\\"reason\\\":\\\"notFound\\\",\\\"message\\\":\\\"Not Found\\\"}],\\\"code\\\":404,\\\"message\\\":\\\"Not Found\\\"}}\"},{\"method\":\"GET\",\"path\":\"/calendars/${path.calendarId}/events\",\"status\":200,\"body\":\"{\\\"kind\\\":\\\"calendar#events\\\",\\\"summary\\\":\\\"${calendar}\\\",\\\"items\\\":[]}\"}]"
              },
              {
                "name": "patchThenBody",
                "text": "aux4/mock --then for an update: makes a later GET of that event (and the list) reflect the patched start/end/summary. A field the PATCH did not send keeps its preset value (via the mock's ${body.x:-default} fallback)",
                "default": "[{\"method\": \"GET\", \"path\": \"/calendars/${path.calendarId}/events/${path.eventId}\", \"status\": 200, \"body\": \"{\\\"kind\\\":\\\"calendar#event\\\",\\\"id\\\":\\\"${path.eventId}\\\",\\\"status\\\":\\\"confirmed\\\",\\\"summary\\\":\\\"${body.summary:-${event}}\\\",\\\"start\\\":{\\\"dateTime\\\":\\\"${body.start.dateTime:-${start}}\\\"},\\\"end\\\":{\\\"dateTime\\\":\\\"${body.end.dateTime:-${end}}\\\"}}\"}, {\"method\": \"GET\", \"path\": \"/calendars/${path.calendarId}/events\", \"status\": 200, \"body\": \"{\\\"kind\\\":\\\"calendar#events\\\",\\\"summary\\\":\\\"${calendar}\\\",\\\"items\\\":[{\\\"kind\\\":\\\"calendar#event\\\",\\\"id\\\":\\\"${path.eventId}\\\",\\\"status\\\":\\\"confirmed\\\",\\\"summary\\\":\\\"${body.summary:-${event}}\\\",\\\"start\\\":{\\\"dateTime\\\":\\\"${body.start.dateTime:-${start}}\\\"},\\\"end\\\":{\\\"dateTime\\\":\\\"${body.end.dateTime:-${end}}\\\"}}]}\"}]"
              },
              {
                "name": "createThenBody",
                "text": "aux4/mock --then for a create: makes a later GET by the fixed --eventId return the created event's summary/start/end. A field the create request did not send resolves to an empty string",
                "default": "[{\"method\":\"GET\",\"path\":\"/calendars/${path.calendarId}/events/${eventId}\",\"status\":200,\"body\":\"{\\\"kind\\\":\\\"calendar#event\\\",\\\"id\\\":\\\"${eventId}\\\",\\\"status\\\":\\\"confirmed\\\",\\\"summary\\\":\\\"${body.summary}\\\",\\\"start\\\":{\\\"dateTime\\\":\\\"${body.start.dateTime}\\\"},\\\"end\\\":{\\\"dateTime\\\":\\\"${body.end.dateTime}\\\"}}\"}]"
              },
              {
                "name": "patchResponseBody",
                "text": "Body returned by PATCH/PUT of an event: the event with the sent fields applied (fields not sent keep their preset values).",
                "default": "{\"kind\":\"calendar#event\",\"id\":\"${path.eventId}\",\"status\":\"confirmed\",\"summary\":\"${body.summary:-${event}}\",\"start\":{\"dateTime\":\"${body.start.dateTime:-${start}}\"},\"end\":{\"dateTime\":\"${body.end.dateTime:-${end}}\"}}"
              },
              {
                "name": "patchBodyFile",
                "text": "Scratch file the PATCH response template is written to.",
                "default": ".mock-preset-google-calendar-patch-${port}${name}.json"
              }
            ]
          }
        }
      ]
    }
  ]
}
